MEMORY
{
    rom(rx)   : ORIGIN = 0x0,       LENGTH = 0x1000000
    ram_a(rw) : ORIGIN = 0x1000000, LENGTH = 0x0800000
    ram_b(rw) : ORIGIN = 0x1800000, LENGTH = 0x0800000
}
SECTIONS
{
    .boot : { *(.boot) 
        KEEP (*(.boot)) 
    } > rom
    .vectors 0xc0 : {
        KEEP (*(.vectors))
    } > rom
    .srodata : { *(.srodata*) } > rom
    .early_text : { *(.early_text*) } > rom
    .text : { *(.text*) } > rom
    /* C++ global constructor pointers; walked by __runtime_init.
       (No .fini_array: embedded firmware never exits.) */
    .init_array : {
        . = ALIGN(4);
        __init_array_start = .;
        KEEP (*(SORT_BY_INIT_PRIORITY(.init_array.*)))
        KEEP (*(.init_array))
        __init_array_end = .;
    } > rom
    .rodata : { *(.rodata*) } > rom

    .peri : {
        . = ALIGN(4);
        __peri_data_start__ = .;
        *(.peri_data*)
        . = ALIGN(4);
        __peri_data_end__ = .;
        *(.peri_bss*)
    } > ram_a AT> rom
    __peri_lma = LOADADDR(.peri);

    /* Used for interrupt context */
    .scratch 0x1000200 : {
        . += 0x30;
    } > ram_a

    .data : { 
        __data_start_unaligned__ = .;
        . = ALIGN(16);
        __data_start__ = .;
        *(.sdata*) *(.data*) 
        . = ALIGN(16);
        __data_end__ = .;
    } > ram_a AT> rom
    __data_lma = LOADADDR(.data) + __data_start__ - __data_start_unaligned__;

    .bss (NOLOAD): { 
        . = ALIGN(16);
        __bss_start__ = .;
        *(.sbss*) *(.bss*)
        . = ALIGN(16);
        __bss_end__ = .;
    } > ram_a

    .uninitialized_data (NOLOAD): {
        . = ALIGN(16);
        *(.uninitialized_data*)

        /* Interrupt stack */
        . = ALIGN(16);
        . += 0x1000;
        __interrupt_stack_top = .;
    } > ram_a

    /* Heap: the free span of ram_a between the static image and the main
       stack, minus a 64KB guard.  _sbrk() enforces __HeapLimit.  ram_b is
       left entirely to the application.

       Local copy of the SDK memmap (which has an empty .heap in ram_b):
       the TUI's curses windows and command scrollback come from malloc,
       so this build needs a real heap. */
    .heap (NOLOAD):
    {
        . = ALIGN(16);
        __HeapStart = .;
        KEEP(*(.heap*))
    } > ram_a

    __global_pointer$ = 0x1000400;
    __StackTop = ORIGIN(ram_a) + LENGTH(ram_a);
    __StackLimit = __StackTop - 0x1000;
    __HeapLimit = __StackLimit - 0x10000;
    ASSERT(__StackLimit >= __interrupt_stack_top, "region RAM overflowed")
    ASSERT(__HeapLimit >= __HeapStart, "no room for heap in ram_a")
}
